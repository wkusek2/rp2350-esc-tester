; Bidirectional DShot (ramka odwrocona: idle = high) dla jednego silnika na jednej SM.
; 40 cykli PIO na bit DShot (clkdiv = sys_clk / (bitrate * 40)).
;   bit 0: low 15 cykli (37.5%), high 25
;   bit 1: low 30 cykli (75%),   high 10
; Po 16 bitach pin -> wejscie, czekanie na zbocze opadajace odpowiedzi ESC (timeout
; ~2100 cykli), potem 192 probki co 4 cykle (bit GCR = 32 cykle -> 8 probek/bit,
; okno 24 bity) wypychane autopushem jako 6 slow 32-bit (MSB = pierwsza probka).
; Timeout: probkowanie leci i tak -> same jedynki -> CPU widzi "brak odpowiedzi".

.program dshot_bidir
.side_set 1

.wrap_target
    set pindirs, 1      side 1          ; pin jako wyjscie, stan wysoki (idle)
    pull block          side 1          ; czekaj na ramke (16 bitow w MSB)
bitloop:
    out x, 1            side 0 [13]     ; 14 cykli low
    jmp !x, bitzero        side 0          ; 15. cykl low
    nop                 side 0 [14]     ; bit 1: +15 low (razem 30)
    jmp bitend            side 1 [4]      ; 5 high
bitzero:
    nop                 side 1 [15]     ; bit 0: 16 high
    nop                 side 1 [3]      ; +4 high
bitend:
    jmp !osre, bitloop  side 1 [4]      ; +5 high (bit0: 25, bit1: 10)

    set pindirs, 0      side 1          ; linia zwolniona (pull-up trzyma high)
    set y, 31           side 1
outer:
    set x, 31           side 1
inner:
    jmp pin, nostart    side 1          ; high -> czekaj dalej
    jmp dosample          side 1          ; zbocze opadajace -> start odpowiedzi
nostart:
    jmp x--, inner      side 1
    jmp y--, outer      side 1
dosample:                                 ; (timeout tez tu trafia)
    set x, 23           side 1          ; 24 x 8 probek = 192
sloop:
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [3]
    in pins, 1          side 1 [2]
    jmp x--, sloop      side 1
.wrap

% c-sdk {
#include "hardware/clocks.h"
static inline void dshot_bidir_program_init(PIO pio, uint sm, uint offset, uint pin, uint bitrate) {
    pio_gpio_init(pio, pin);
    gpio_pull_up(pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_config c = dshot_bidir_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_out_shift(&c, false, false, 16);   // shift left, MSB first, bez autopull, prog 16
    sm_config_set_in_shift(&c, false, true, 32);     // shift left, autopush co 32 probki
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (float)(bitrate * 40));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
